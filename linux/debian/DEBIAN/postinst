#!/bin/sh
set -eu

if [ "${1:-}" != configure ]; then
  exit 0
fi

root=${DPKG_ROOT:-}
root=${root%/}
case "$root" in
  ""|/*) ;;
  *)
    printf 'xkb-qwerty-fr: invalid DPKG_ROOT: %s\n' "$root" >&2
    exit 1
    ;;
esac

state_parent="$root/var/lib/xkb-qwerty-fr"
state_dir="$state_parent/upgrade-state"
recovery_dir="$root/var/backups/xkb-qwerty-fr"

if [ ! -e "$state_dir" ] && [ ! -L "$state_dir" ]; then
  exit 0
fi

if [ -L "$state_dir" ] || [ ! -d "$state_dir" ] || \
   [ ! -f "$state_dir/active" ] || [ -L "$state_dir/active" ] || \
   [ ! -f "$state_dir/applied" ] || [ -L "$state_dir/applied" ]; then
  printf 'xkb-qwerty-fr: invalid migration state: %s\n' "$state_dir" >&2
  exit 1
fi

if [ -f "$state_dir/recovery.present" ]; then
  if [ -L "$state_dir/recovery" ] || [ ! -f "$state_dir/recovery" ] || \
     [ -L "$state_dir/id" ] || [ ! -f "$state_dir/id" ]; then
    printf 'xkb-qwerty-fr: invalid recovery state: %s\n' "$state_dir" >&2
    exit 1
  fi

  state_id=$(cat "$state_dir/id")
  case "$state_id" in
    ""|*[!A-Za-z0-9._-]*)
      printf 'xkb-qwerty-fr: invalid migration state identifier\n' >&2
      exit 1
      ;;
  esac
  recovery_file="$recovery_dir/us.before-migration.$state_id"
  if [ -L "$recovery_file" ] || [ ! -f "$recovery_file" ] || \
     ! cmp -s "$state_dir/recovery" "$recovery_file"; then
    printf 'xkb-qwerty-fr: missing migration recovery file: %s\n' \
      "$recovery_file" >&2
    exit 1
  fi
fi

rm -rf -- "$state_dir"
rmdir -- "$state_parent" 2>/dev/null || true
